{
  "name": "@daily-energy/app-worker",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "format:check": "prettier --check README.md package.json tsconfig*.json src",
    "lint": "eslint --max-warnings=0 src",
    "prebuild": "node --eval \"import('node:fs/promises').then(({ rm }) => rm('dist', { force: true, recursive: true }))\"",
    "pretest": "node ../../tooling/ensure-server-adapters-build.mjs && pnpm run build",
    "start:background": "node dist/run-background.js",
    "start:interactive": "node dist/run-interactive.js",
    "start:restricted": "node dist/run-restricted.js",
    "test": "vitest run src",
    "typecheck": "node ../../tooling/typecheck-workspace.mjs"
  },
  "dailyEnergy": {
    "kind": "app",
    "runtime": "server-adapter"
  },
  "dependencies": {
    "@daily-energy/server-adapters": "workspace:*",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@daily-energy/typescript-config": "workspace:*",
    "vitest": "catalog:"
  }
}
