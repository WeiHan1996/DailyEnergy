@import "./generated/design-tokens.wxss";

page {
  min-height: 100%;
  background: var(--de-color-canvas);
  color: var(--de-color-text-primary);
  font-family: var(--de-font-family);
}

button {
  min-height: var(--de-state-touch-target);
  border-radius: var(--de-component-button-radius);
  font-family: var(--de-font-family);
  font-weight: var(--de-font-semibold);
}

button::after {
  border: none;
}

button:focus {
  outline: var(--de-state-focus-width) solid var(--de-color-focus);
  outline-offset: var(--de-state-focus-width);
}
