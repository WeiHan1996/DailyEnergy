<view class="recovery" data-screen-id="{{screenId}}">
  <view class="recovery__eyebrow">先停一下</view>
  <view class="recovery__title">这一分钟还没准备好</view>
  <view class="recovery__message">
    可能只是短暂的连接问题。你可以再试一次，也可以晚点回来。
  </view>
  <button class="recovery__button" bindtap="retry">重新连接</button>
  <view class="recovery__reason">参考：{{reasonCode}}</view>
</view>
