.recovery {
  box-sizing: border-box;
  display: flex;
  min-height: var(--de-layout-page-min-height);
  padding: var(--de-layout-section-gap) var(--de-layout-page-gutter-wide);
  align-items: flex-start;
  flex-direction: column;
}

.recovery__eyebrow {
  margin-bottom: var(--de-component-card-gap);
  color: var(--de-color-text-muted);
  font-size: var(--de-font-label-size);
  font-weight: var(--de-font-semibold);
}

.recovery__title {
  color: var(--de-color-text-primary);
  font-size: var(--de-font-page-title-size);
  font-weight: var(--de-font-semibold);
  line-height: var(--de-font-line-heading);
}

.recovery__message {
  margin-top: var(--de-layout-content-gap);
  color: var(--de-color-text-secondary);
  font-size: var(--de-font-body-size);
  line-height: var(--de-font-line-relaxed);
}

.recovery__button {
  width: 100%;
  margin-top: var(--de-layout-section-gap);
  background: var(--de-color-brand-primary);
  color: var(--de-color-text-inverse);
  font-size: var(--de-font-body-size);
}

.recovery__reason {
  margin-top: auto;
  color: var(--de-color-text-muted);
  font-size: var(--de-font-meta-size);
}
