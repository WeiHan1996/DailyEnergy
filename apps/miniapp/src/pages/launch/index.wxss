.launch {
  box-sizing: border-box;
  display: flex;
  min-height: 100vh;
  padding: 168rpx 72rpx 96rpx;
  align-items: center;
  flex-direction: column;
  text-align: center;
}

.launch__mark {
  display: flex;
  width: 132rpx;
  height: 132rpx;
  margin-bottom: 48rpx;
  align-items: center;
  justify-content: center;
  border-radius: 44rpx;
  background: #dce9df;
  color: #2f5b45;
  font-size: 42rpx;
  font-weight: 700;
  letter-spacing: 2rpx;
}

.launch__eyebrow {
  margin-bottom: 22rpx;
  color: #65766e;
  font-size: 22rpx;
  font-weight: 600;
  letter-spacing: 7rpx;
}

.launch__title {
  max-width: 560rpx;
  color: #24302b;
  font-size: 48rpx;
  font-weight: 650;
  line-height: 1.35;
}

.launch__status {
  margin-top: 40rpx;
  color: #607068;
  font-size: 28rpx;
  line-height: 1.6;
}

.launch__environment {
  margin-top: auto;
  color: #8b9791;
  font-size: 22rpx;
}
