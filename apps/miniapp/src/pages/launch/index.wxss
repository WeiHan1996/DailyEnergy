.launch {
  box-sizing: border-box;
  display: flex;
  min-height: var(--de-layout-page-min-height);
  padding: var(--de-layout-section-gap) var(--de-layout-page-gutter-wide);
  align-items: center;
  flex-direction: column;
  text-align: center;
}

.launch__mark {
  display: flex;
  width: var(--de-component-header-height);
  height: var(--de-component-header-height);
  margin-bottom: var(--de-layout-page-gutter-wide);
  align-items: center;
  justify-content: center;
  border-radius: var(--de-component-card-radius);
  background: var(--de-color-brand-soft);
  color: var(--de-color-brand-strong);
  font-size: var(--de-font-section-size);
  font-weight: var(--de-font-bold);
}

.launch__eyebrow {
  margin-bottom: var(--de-component-card-gap);
  color: var(--de-color-text-muted);
  font-size: var(--de-font-meta-size);
  font-weight: var(--de-font-semibold);
}

.launch__title {
  max-width: var(--de-layout-content-max);
  color: var(--de-color-text-primary);
  font-size: var(--de-font-page-title-size);
  font-weight: var(--de-font-semibold);
  line-height: var(--de-font-line-heading);
}

.launch__status {
  margin-top: var(--de-layout-page-gutter);
  color: var(--de-color-text-secondary);
  font-size: var(--de-font-body-size);
  line-height: var(--de-font-line-body);
}

.launch__environment {
  margin-top: auto;
  color: var(--de-color-text-muted);
  font-size: var(--de-font-meta-size);
}
