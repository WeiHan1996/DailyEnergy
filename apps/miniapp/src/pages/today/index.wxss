.today {
  display: flex;
  flex-direction: column;
  gap: var(--de-layout-section-gap);
}

.today__hero {
  display: flex;
  flex-direction: column;
  gap: var(--de-component-header-gap);
}

.today__greeting {
  color: var(--de-color-text-primary);
  font-size: var(--de-font-body-large-size);
  font-weight: var(--de-font-semibold);
  line-height: var(--de-font-line-heading);
}

.today__label,
.today__focus-meta {
  color: var(--de-color-brand-strong);
  font-size: var(--de-font-meta-size);
  font-weight: var(--de-font-semibold);
  line-height: var(--de-font-line-heading);
}

.today__focus {
  display: flex;
  flex-direction: column;
  gap: var(--de-component-card-gap);
}

.today__focus-title {
  color: var(--de-color-text-primary);
  font-size: var(--de-font-page-title-size);
  font-weight: var(--de-font-semibold);
  line-height: var(--de-font-line-heading);
}

.today__focus-copy,
.today__optional-task,
.today__dimension-copy,
.today__ritual-note,
.today__closing,
.today__boundary {
  color: var(--de-color-text-secondary);
  font-size: var(--de-font-body-size);
  line-height: var(--de-font-line-body);
}

.today__dimension {
  display: flex;
  padding: var(--de-component-notice-padding) 0;
  flex-direction: column;
  border-bottom: var(--de-component-card-border-width) solid
    var(--de-color-border-subtle);
  gap: var(--de-component-header-gap);
}

.today__dimension:last-of-type {
  border-bottom: 0;
}

.today__dimension-heading {
  display: flex;
  align-items: center;
  justify-content: space-between;
  color: var(--de-color-text-primary);
  font-size: var(--de-font-label-size);
  font-weight: var(--de-font-semibold);
  gap: var(--de-component-card-gap);
}

.today__dimension--focus {
  padding-top: 0;
}

.today__ritual {
  display: flex;
  align-items: flex-start;
  gap: var(--de-component-card-gap);
}

.today__ritual-value {
  min-width: calc(var(--de-state-touch-target) * 1.5);
  color: var(--de-color-brand-strong);
  font-size: var(--de-font-body-size);
  font-weight: var(--de-font-semibold);
}

.today__ritual-note {
  flex: 1;
}

.today__closing {
  color: var(--de-color-text-primary);
  font-weight: var(--de-font-semibold);
}

.today__boundary {
  padding-bottom: var(--de-layout-section-gap);
  color: var(--de-color-text-muted);
  font-size: var(--de-font-meta-size);
}
