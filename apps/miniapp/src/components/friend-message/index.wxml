<view class="de-friend-message" aria-role="article">
  <view class="de-friend-message__marker" aria-hidden="true"></view>
  <view class="de-friend-message__content">
    <view class="de-friend-message__label">{{label}}</view>
    <view wx:if="{{title}}" class="de-friend-message__title">{{title}}</view>
    <view class="de-friend-message__body">{{body}}</view>
    <view wx:if="{{fallback}}" class="de-friend-message__fallback">
      基础内容
    </view>
  </view>
</view>
