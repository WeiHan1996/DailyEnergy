<view
  class="de-energy-summary {{loading ? 'de-energy-summary--loading' : ''}}"
  aria-busy="{{loading}}"
  aria-label="{{label}}，{{score}}，{{level}}。{{context}}"
  aria-role="article"
>
  <view class="de-energy-summary__meta">
    <text>{{context}}</text>
    <text wx:if="{{offline}}" class="de-energy-summary__state">离线内容</text>
  </view>
  <view class="de-energy-summary__label">{{label}}</view>
  <view wx:if="{{loading}}" class="de-energy-summary__skeleton" aria-hidden="true"></view>
  <view wx:else class="de-energy-summary__value-row">
    <text class="de-energy-summary__score">{{score}}</text>
    <view class="de-energy-summary__meaning">
      <text class="de-energy-summary__level">{{level}}</text>
      <text wx:if="{{detail}}" class="de-energy-summary__detail">{{detail}}</text>
    </view>
  </view>
</view>
