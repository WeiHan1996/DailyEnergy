{
  "name": "@daily-energy/app-miniapp",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "build": "node ../../tooling/build-miniapp.mjs",
    "bundle:check": "node ../../tooling/check-miniapp-bundle.mjs",
    "format:check": "prettier --check README.md package.json project*.json public-build.config.json tsconfig*.json src",
    "lint": "eslint --max-warnings=0 src",
    "test": "vitest run src && node ../../tooling/test-miniapp-bundle.mjs",
    "test:devtools": "node ../../tooling/run-miniapp-automator.mjs",
    "typecheck": "node ../../tooling/typecheck-workspace.mjs"
  },
  "dailyEnergy": {
    "kind": "app",
    "runtime": "client-safe"
  },
  "devDependencies": {
    "@daily-energy/typescript-config": "workspace:*",
    "miniprogram-api-typings": "catalog:",
    "vitest": "catalog:"
  }
}
