{
  "name": "@daily-energy/app-admin",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "next build --webpack && pnpm run bundle:check",
    "bundle:check": "node ../../tooling/check-admin-bundle.mjs",
    "dev": "next dev",
    "format:check": "prettier --check README.md package.json next.config.ts playwright.config.ts response-fixture.playwright.config.ts tsconfig.json src tests",
    "lint": "eslint --max-warnings=0 next.config.ts playwright.config.ts response-fixture.playwright.config.ts src tests",
    "start": "next start",
    "test": "vitest run src && pnpm run test:e2e",
    "test:e2e": "node ../../tooling/run-admin-playwright.mjs",
    "typecheck": "next typegen && node ../../tooling/typecheck-workspace.mjs"
  },
  "dailyEnergy": {
    "kind": "app",
    "runtime": "client-safe"
  },
  "dependencies": {
    "@daily-energy/api-client": "workspace:*",
    "next": "catalog:",
    "react": "catalog:",
    "react-dom": "catalog:",
    "server-only": "catalog:"
  },
  "devDependencies": {
    "@daily-energy/typescript-config": "workspace:*",
    "@playwright/test": "catalog:",
    "@types/node": "catalog:",
    "@types/react": "catalog:",
    "@types/react-dom": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:"
  }
}
