    },
    {
      "id": "known-fail-pr-head-mismatch",
      "issue": { "number": 105, "state": "OPEN" },
      "localMainSha": "main-sha",
      "remoteMainSha": "main-sha",
      "gitScope": { "branch": "agent/task", "headSha": "head-sha" },
      "pullRequest": {
        "number": 106,
        "state": "OPEN",
        "headRefName": "agent/other",
        "headRefOid": "other-sha"
      },
      "expectedRuleIds": ["REMOTE_PR_HEAD_MISMATCH"]
    },
    {
      "id": "detached-head-matches-pr-commit",
      "issue": { "number": 105, "state": "OPEN" },
      "localMainSha": "main-sha",
      "remoteMainSha": "main-sha",
      "gitScope": { "headSha": "head-sha" },
      "pullRequest": {
        "number": 106,
        "state": "OPEN",
        "headRefName": "agent/task",
        "headRefOid": "head-sha"
      },
      "expectedRuleIds": []
    }
  ],
  "redactionCases": [
    {
      "id": "redact-bearer-and-secret",
      "input": "Authorization: Bearer abc.def\nSESSION_SECRET=real-value",
      "forbidden": ["abc.def", "real-value"],
      "required": ["[REDACTED]"]
    },
    {
      "id": "redact-json-credentials",
      "input": "{\"token\":\"json-token-value\",\"password\":\"json-password-value\"}",
      "forbidden": ["json-token-value", "json-password-value"],
      "required": ["[REDACTED]"]
    }
  ],
  "boundedOutputCases": [
    {
      "id": "bounded-tail-only",
      "inputLineCount": 120,
      "lineLimit": 10,
      "maxChars": 300,
      "required": "line-119",
      "forbidden": "line-000"
    },
    {
      "id": "root-cause-and-tail",
      "input": "start\nTypeError: first root cause\ncontext-a\ncontext-b\nnoise-1\nnoise-2\nnoise-3\nnoise-4\nnoise-5\nnoise-6\nfinal-tail",
      "lineLimit": 2,
      "maxChars": 500,
      "requiredValues": ["TypeError: first root cause", "final-tail"]
    }
  ]
