{
  "version": 1,
  "contextCases": [
    {
      "id": "known-pass-single-current",
      "requestedTaskId": "E-015",
      "currentTaskId": "E-015",
      "mainIsCurrent": true,
      "activeTasks": [{ "taskId": "E-015", "state": "In Progress" }],
      "expectedRuleIds": []
    },
    {
      "id": "known-fail-stale-main",
      "requestedTaskId": "E-015",
      "currentTaskId": "E-015",
      "mainIsCurrent": false,
      "activeTasks": [{ "taskId": "E-015", "state": "In Progress" }],
      "expectedRuleIds": ["CONTEXT_MAIN_STALE"]
    },
    {
      "id": "known-fail-multiple-active",
      "requestedTaskId": "E-015",
      "currentTaskId": "E-015",
      "mainIsCurrent": true,
      "activeTasks": [
        { "taskId": "E-006", "state": "Ready" },
        { "taskId": "E-015", "state": "In Progress" }
      ],
      "expectedRuleIds": ["CONTEXT_MULTIPLE_ACTIVE_TASKS"]
    },
    {
      "id": "known-fail-task-mismatch",
      "requestedTaskId": "E-006",
      "currentTaskId": "E-015",
      "mainIsCurrent": true,
      "activeTasks": [{ "taskId": "E-015", "state": "In Progress" }],
      "expectedRuleIds": ["CONTEXT_TASK_MISMATCH"]
    }
  ],
  "dependencyCases": [
    {
      "id": "known-fail-c003-before-d004",
      "taskId": "C-003",
      "states": { "D-004": "Planned" },
      "expectedRuleIds": ["DEPENDENCY_BLOCKED"]
    },
    {
      "id": "known-pass-c003-after-d004",
      "taskId": "C-003",
      "states": { "D-004": "Done" },
      "expectedRuleIds": []
    },
    {
      "id": "known-fail-c012-before-d005",
      "taskId": "C-012",
      "states": { "D-005": "In Review" },
      "expectedRuleIds": ["DEPENDENCY_BLOCKED"]
    },
    {
      "id": "known-pass-d005-chain",
      "taskId": "D-005",
      "states": { "D-004": "Accepted" },
      "expectedRuleIds": []
    }
  ],
  "routeCases": [
    { "id": "exact-e015", "taskId": "E-015", "expectedProfile": "code" },
    { "id": "hybrid-d002", "taskId": "D-002", "expectedProfile": "hybrid" },
    { "id": "design-d004", "taskId": "D-004", "expectedProfile": "design" },
    { "id": "research-r001", "taskId": "R-001", "expectedProfile": "research" },
    {
      "id": "known-fail-unknown-task",
      "taskId": "S-999",
      "expectedProfile": null
    }
  ],
  "profileOverrideCases": [
    {
      "id": "known-pass-code-to-security",
      "inferredProfile": "code",
      "requestedProfile": "security",
      "expectedProfile": "security"
    },
    {
      "id": "known-fail-code-to-docs",
      "inferredProfile": "code",
      "requestedProfile": "docs",
      "expectedProfile": "code",
      "expectedRuleId": "AGENT_PROFILE_DOWNGRADE_BLOCKED"
    },
    {
      "id": "known-fail-design-to-code",
      "inferredProfile": "design",
      "requestedProfile": "code",
      "expectedProfile": "design",
      "expectedRuleId": "AGENT_PROFILE_DOWNGRADE_BLOCKED"
    },
    {
      "id": "known-pass-docs-to-research",
      "inferredProfile": "docs",
      "requestedProfile": "research",
      "expectedProfile": "research"
    }
  ],
  "changedCases": [
    {
      "id": "known-full-agent-policy",
      "paths": ["docs/agent/workflow.md"],
      "expectedEscalation": "full",
      "expectedRuleIds": ["AGENT_POLICY_REQUIRES_FULL"],
      "expectedImpactProfiles": ["code"]
    },
    {
      "id": "known-full-admin-without-source-map",
      "paths": ["apps/admin/app/page.tsx"],
      "expectedEscalation": "full",
      "expectedRuleIds": ["APPLICATION_OR_TEST_REQUIRES_FULL"],
      "expectedImpactProfiles": ["code"]
    },
    {
      "id": "known-targeted-status-document",
      "paths": ["tasks/current.md"],
      "expectedCommandPrefix": "pnpm run agent:check",
      "expectedRuleIds": ["STATUS_DOCS_TARGETED"],
      "expectedImpactProfiles": ["docs"]
    },
    {
      "id": "known-full-unknown",
      "paths": ["unexpected/new-input.bin"],
      "expectedEscalation": "full",
      "expectedUnknownPaths": ["unexpected/new-input.bin"],
      "expectedImpactProfiles": ["security"]
    },
    {
      "id": "known-full-security",
      "paths": ["apps/api/src/auth/session.ts"],
      "expectedEscalation": "full",
      "expectedRuleIds": [
        "APPLICATION_OR_TEST_REQUIRES_FULL",
        "SECURITY_REQUIRES_FULL"
      ],
      "expectedImpactProfiles": ["code", "security"]
    }
  ],
  "effectiveProfileCases": [
    {
      "id": "d004-plus-miniapp-is-hybrid-full",
      "taskProfile": "design",
      "paths": ["apps/miniapp/src/pages/index.ts"],
      "expectedProfile": "hybrid",
      "expectedEscalation": "full"
    },
    {
      "id": "code-plus-security-path-is-security-full",
      "taskProfile": "code",
      "paths": ["apps/api/src/auth/session.ts"],
      "expectedProfile": "security",
