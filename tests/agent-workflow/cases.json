    },
    {
      "id": "code-plus-docs-remains-code",
      "taskProfile": "code",
      "impactProfiles": ["docs"],
      "expectedProfile": "code"
    },
    {
      "id": "research-plus-code-blocks",
      "taskProfile": "research",
      "impactProfiles": ["code"],
      "expectedProfile": "research",
      "expectedRuleId": "AGENT_PROFILE_COMBINATION_UNSUPPORTED"
    }
  ],
  "topicSourceCases": [
    {
      "id": "agent-topic-adds-path-authorities",
      "taskId": "E-015",
      "paths": ["tooling/lib/git-change-scope.mjs"],
      "expectedPaths": [
