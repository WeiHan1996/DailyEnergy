        "docs/technical/observability.md",
        "docs/technical/repository-structure.md",
        "docs/technical/testing.md",
        "tasks/current.md"
      ],
      "expectedTopicRuleId": "topic:agent-workflow",
      "expectedTrigger": "path:tooling/lib/git-change-scope.mjs"
    }
  ],
  "taskStateCases": [
    {
      "id": "same-state-across-files",
      "documents": [
        {
          "path": "tasks/current.md",
          "content": "**当前任务**： E-015\n**任务状态**： In Review"
        },
        {
          "path": "tasks/backlog.md",
          "content": "| E-015 | Name | In Review |"
        }
      ],
      "expectedStates": { "E-015": "In Review" },
      "expectedRuleIds": []
    },
    {
      "id": "known-fail-conflicting-state",
      "documents": [
        {
          "path": "tasks/current.md",
          "content": "**当前任务**： E-015\n**任务状态**： In Review"
        },
        {
          "path": "tasks/backlog.md",
          "content": "| E-015 | Name | In Progress |"
        }
      ],
      "expectedStates": {},
      "expectedRuleIds": ["CONTEXT_TASK_STATE_CONFLICT"]
    }
  ],
  "validationStatusCases": [
    {
      "id": "dry-run-is-planned",
      "dryRun": true,
      "expectedAutomatedStatus": "NOT_RUN",
      "expectedFinalStatus": "PLANNED"
    },
    {
      "id": "clean-change-scope-is-no-changes",
      "noChanges": true,
      "expectedAutomatedStatus": "NOT_RUN",
      "expectedFinalStatus": "NO_CHANGES"
    },
    {
      "id": "successful-code-run-is-pass",
      "expectedAutomatedStatus": "PASS",
      "expectedFinalStatus": "PASS"
    }
  ],
  "profileFinalStatusCases": [
    {
      "id": "security-preserves-research-authorization",
