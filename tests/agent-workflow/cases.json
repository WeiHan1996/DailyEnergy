  "remoteStateCases": [
    {
      "id": "in-progress-without-pr-is-allowed",
      "issue": { "number": 105, "state": "OPEN" },
      "localMainSha": "main-sha",
      "remoteMainSha": "main-sha",
      "gitScope": { "branch": "agent/task", "headSha": "head-sha" },
