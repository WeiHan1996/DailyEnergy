{
  "policy_version": "e-010-artifact-policy-v1",
  "synthetic_only": true,
  "output_root": "tests/artifacts/output",
  "retention": "local-short-lived",
  "external_upload": false,
  "allowed_metadata": [
    "artifact_version",
    "commit_sha",
    "duration_ms",
    "failure_code",
    "fixture_version",
    "result",
    "runner_version",
    "source_ids",
    "started_at_utc",
    "toolchain_fingerprint"
  ],
  "forbidden_keys": [
    "authorization",
    "cookie",
    "database_url",
    "openid",
    "prompt",
    "provider_raw_body",
    "safety_raw_text",
    "secret",
    "token",
    "unionid"
  ],
  "forbidden_value_patterns": [
    "-----BEGIN [A-Z ]+PRIVATE KEY-----",
    "postgres(?:ql)?://[^\\s]+",
    "redis://[^\\s]+",
    "Bearer\\s+[A-Za-z0-9._~-]+",
    "(?:^|[^0-9])1[3-9][0-9]{9}(?:$|[^0-9])"
  ]
}
