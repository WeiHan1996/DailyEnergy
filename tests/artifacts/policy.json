{
  "policy_version": "e-010-artifact-policy-v1",
  "synthetic_only": true,
  "output_root": "tests/artifacts/output",
  "retention": "local-short-lived",
  "external_upload": false,
  "allowed_metadata": [
    "artifact_version",
    "base_sha",
    "branch",
    "command_count",
    "completed_command_count",
    "duration_ms",
    "ended_at_utc",
    "event_name",
    "failed_command_ordinal",
    "failure_code",
    "fixture_version",
    "head_sha",
    "lane_id",
    "lockfile_sha256",
    "next_action",
    "pull_request",
    "registry_version",
    "repository",
    "result",
    "runner_version",
    "source_ids",
    "started_at_utc",
    "tested_sha",
    "tool_versions",
    "toolchain_fingerprint"
  ],
  "forbidden_keys": [
    "authorization",
    "cookie",
    "database_url",
    "check_in",
    "checkin",
    "matter",
    "note",
    "openid",
    "preferred_name",
    "prompt",
    "provider_response",
    "provider_raw_body",
    "raw_response",
    "safety_content",
    "safety_raw_text",
    "secret",
    "token",
    "unionid"
  ],
  "forbidden_value_patterns": [
    "-----BEGIN [A-Z ]+PRIVATE KEY-----",
    "postgres(?:ql)?://[^\\s]+",
    "redis://[^\\s]+",
    "Bearer\\s+[A-Za-z0-9._~-]+",
    "(?:^|[^0-9])1[3-9][0-9]{9}(?:$|[^0-9])"
  ]
}
