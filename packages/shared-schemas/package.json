{
  "name": "@daily-energy/shared-schemas",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Executable DailyEnergy runtime contracts and inferred TypeScript types.",
  "dailyEnergy": {
    "kind": "package",
    "runtime": "client-safe"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./json-schema": {
      "types": "./dist/json-schema.d.ts",
      "import": "./dist/json-schema.js"
    }
  },
  "files": [
    "dist",
    "README.md"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.check.json",
    "test": "vitest run",
    "format:check": "prettier --check .",
    "validate": "pnpm run format:check && pnpm run typecheck && pnpm run test && pnpm run build"
  },
  "dependencies": {
    "zod": "catalog:"
  },
  "devDependencies": {
    "prettier": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:"
  }
}
