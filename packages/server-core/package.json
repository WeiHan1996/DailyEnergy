{
  "name": "@daily-energy/server-core",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "exports": {
    "./content-publication": {
      "types": "./dist/modules/content-publication/public/index.d.ts",
      "import": "./dist/modules/content-publication/public/index.js"
    },
    "./generation": {
      "types": "./dist/modules/generation/public/index.d.ts",
      "import": "./dist/modules/generation/public/index.js"
    },
    "./generation/spi": {
      "types": "./dist/modules/generation/spi/index.d.ts",
      "import": "./dist/modules/generation/spi/index.js"
    },
    "./product-time": {
      "types": "./dist/modules/product-time/public/index.d.ts",
      "import": "./dist/modules/product-time/public/index.js"
    },
    "./product-time/spi": {
      "types": "./dist/modules/product-time/spi/index.d.ts",
      "import": "./dist/modules/product-time/spi/index.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "format:check": "prettier --check README.md package.json tsconfig*.json src",
    "lint": "eslint --max-warnings=0 src",
    "prebuild": "node --eval \"import('node:fs/promises').then(({ rm }) => rm('dist', { force: true, recursive: true }))\"",
    "test": "vitest run src",
    "typecheck": "node ../../tooling/typecheck-workspace.mjs"
  },
  "dailyEnergy": {
    "kind": "package",
    "runtime": "server-core"
  },
  "dependencies": {
    "@daily-energy/shared-schemas": "workspace:*"
  },
  "devDependencies": {
    "@daily-energy/typescript-config": "workspace:*",
    "vitest": "catalog:"
  }
}
