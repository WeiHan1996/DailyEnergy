{
  "annotations": { "list": [] },
  "editable": false,
  "panels": [
    {
      "id": 1,
      "title": "Status: PROVISIONAL / BLOCKED",
      "type": "stat",
      "targets": [
        {
          "expr": "min(dailyenergy:cost_known_ratio:35d or vector(0), dailyenergy:cost_price_coverage_ratio:35d or vector(0))"
        }
      ]
    },
    {
      "id": 2,
      "title": "Generation mode",
      "type": "timeseries",
      "targets": [
        {
          "expr": "sum by (generation_mode) (rate(dailyenergy_gateway_generation_mode_total[15m]))"
        }
      ]
    },
    {
      "id": 3,
      "title": "Gateway latency",
      "type": "timeseries",
      "targets": [
        {
          "expr": "histogram_quantile(0.95, sum by (le, workload) (rate(dailyenergy_gateway_end_to_end_duration_seconds_bucket[15m])))"
        }
      ]
    },
    {
      "id": 4,
      "title": "Observed model mismatch",
      "type": "stat",
      "targets": [
        {
          "expr": "sum(increase(dailyenergy_gateway_observed_model_mismatch_total[24h]))"
        }
      ]
    },
    {
      "id": 5,
      "title": "Actual / estimated / unknown completeness",
      "type": "timeseries",
      "targets": [
        { "expr": "dailyenergy:cost_known_ratio:35d" },
        { "expr": "dailyenergy:cost_price_coverage_ratio:35d" }
      ]
    },
    {
      "id": 6,
      "title": "Budget 70 / 85 / 100",
      "type": "gauge",
      "targets": [{ "expr": "dailyenergy:budget_consumption_ratio" }]
    },
    {
      "id": 7,
      "title": "AI cost by workload (no user dimension)",
      "type": "timeseries",
      "targets": [
        {
          "expr": "sum by (workload) (increase(dailyenergy_gateway_cost_micros_total[24h]))"
        }
      ]
    },
    {
      "id": 8,
      "title": "Observability share",
      "type": "timeseries",
      "targets": [
        {
          "expr": "sum(increase(dailyenergy_cost_micros_total{operation_code=\"TELEMETRY_EXPORT\"}[30d])) / clamp_min(sum(increase(dailyenergy_cost_micros_total[30d])), 1)"
        }
      ]
    }
  ],
  "refresh": "30s",
  "schemaVersion": 41,
  "tags": [
    "dailyenergy",
    "ai",
    "cost",
    "contract:dailyenergy-telemetry-v1",
    "window:35d",
    "environment:single",
    "freshness:required"
  ],
  "templating": {
    "list": [
      {
        "name": "environment",
        "type": "custom",
        "query": "LOCAL,CI,DEV,STAGING",
        "current": { "text": "CI", "value": "CI" }
      }
    ]
  },
  "time": { "from": "now-35d", "to": "now" },
  "title": "AI Cost",
  "uid": "ai-cost",
  "version": 1
}
