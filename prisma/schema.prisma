// DailyEnergy S-19 Prisma structure draft — Accepted 2026-07-22 with
// docs/technical/database.md (PR #22 merged; acceptance handoff follows).
//
// Target syntax: Prisma ORM 7 with PostgreSQL. Connection configuration belongs
// in prisma.config.ts and is intentionally not created in this specification PR.
//
// This file is not a migration. PostgreSQL-only invariants that Prisma Schema
// cannot express safely are listed in docs/technical/database.md and MUST be
// added by reviewed SQL migrations before E-006 is considered complete.

generator client {
  provider = "prisma-client"
  output   = "../packages/server-adapters/src/db/generated/prisma"
}

datasource db {
  provider     = "postgresql"
  relationMode = "foreignKeys"
}

enum AccountState {
  ACTIVE
  RESTRICTED
  DELETING
  DELETED
}

enum ConsentStatus {
  ACCEPTED
  WITHDRAWN
}

enum ExpressionStyle {
  BALANCED
  GENTLE
  LIGHT_HUMOR
  CLEAR_DIRECT
}

enum CheckinMood {
  VERY_LOW
  LOW
  STEADY
  GOOD
  LIGHT
  UNSURE
}

enum CheckinEnergy {
  EMPTY
  LOW
  STEADY
  HIGH
  FULL
  UNSURE
}

enum CheckinSleep {
  POOR
  LOW
  OKAY
  GOOD
  UNSURE
}

enum GenerationState {
  QUEUED
  RUNNING
  FALLBACK_RUNNING
  RETRYABLE_FAILED
  SUCCEEDED
  TERMINAL_FAILED
  CANCELLED
}

enum InvocationWorkload {
  DAILY
  WEEKLY
}

enum GatewayRouteRole {
  PRIMARY
  BACKUP
  CONTROLLED_TEMPLATE
}

enum GatewayAttemptOutcome {
  SUCCEEDED
  TIMEOUT
  PROVIDER_ERROR
  INVALID_SCHEMA
  UNSAFE
  BUDGET_EXHAUSTED
  CIRCUIT_OPEN
  CANCELLED
  BLOCKED
}

enum ContentDisplayState {
  AVAILABLE
  FALLBACK_ONLY
  BLOCKED
}

enum DailyTaskStatus {
  UNMARKED
  INTERESTED
  COMPLETED
  SKIPPED
}

enum HelpfulnessRating {
  HELPFUL
  NEUTRAL
  NOT_HELPFUL
  NOT_USED
}

enum OverallFeeling {
  VERY_HEAVY
  SOMEWHAT_HEAVY
  STEADY
  PRETTY_GOOD
  LIGHT
  UNSURE
}

enum RelationshipCycleState {
  ACTIVE
  CLOSED_BY_DELETION
}

enum MatterState {
  ACTIVE
  PAUSED
  COMPLETED
  EXPIRED
  DELETED
}

enum MemoryGrantState {
  ACTIVE
  REVOKED
}

enum MemoryPurpose {
  DAILY_EXPRESSION
  WEEKLY_SUMMARY
  REMINDER
  RELATIONSHIP_EXPRESSION
}

enum SafetyStatus {
  CLEAR
  ACTIVE
  RECOVERY_PENDING
}

enum SafetyDecisionLevel {
  CLEAR
  PROFESSIONAL_BOUNDARY
  HIGH_RISK
}

enum NotificationIntentState {
  SCHEDULED
  CANCELLED
  SUPPRESSED
  SENT
  OPENED
  EXPIRED
}

enum DataTaskKind {
  DELETE
  EXPORT
}

enum DataTaskScope {
  DAY
  MATTER
  RELATIONSHIP_DATA
  ACCOUNT
  EXPORT_ACCOUNT
  EXPORT_DATE_RANGE
}

enum DataTaskState {
  QUEUED
  RUNNING
  FAILED
  SUCCEEDED
  CANCELLED
}

enum ExportArtifactState {
  PREPARING
  READY
  EXPIRED
  INVALIDATED
}

enum DeletionStepState {
  PENDING
  RUNNING
  FAILED
  SUCCEEDED
}

enum DeletionOutcome {
  SUCCEEDED
  FAILED
  RESTRICTED_EXCEPTION
}

enum RetentionDataClass {
  T0_TRANSIENT
  T1_ACTIVE_PRODUCT
  T2_RESTRICTED_EVIDENCE
  T3_ISOLATED_BACKUP
  T4_ANONYMOUS_SYSTEM
}

enum RetentionScope {
  ACCOUNT
  DAY
  MATTER
  RELATIONSHIP_DATA
  SAFETY
  NOTIFICATION
  EXPORT
  RUNTIME
  EVALUATION
  LEGAL_EVIDENCE
  SYSTEM
}

enum RetentionTerminalAction {
  DELETE
  ANONYMIZE
  RESTRICTED_FREEZE
}

enum CatalogStatus {
  STAGED
  ACTIVE
  DISABLED
  RETIRED
}

enum ProviderDeletionState {
  QUEUED
  SENT
  ACKNOWLEDGED
  TTL_ONLY
  FAILED
  EXPIRED
}

enum BackupState {
  AVAILABLE
  RESTORING_ISOLATED
  EXPIRED
  PURGED
}

enum LegalHoldState {
  ACTIVE
  RELEASED
  EXPIRED
}

enum OutboxState {
  PENDING
  PUBLISHED
  FAILED
}

enum EvaluationRunState {
  PLANNED
  RUNNING
  COMPLETED
  FAILED
}

model UserAccount {
  id                      String         @id @default(uuid()) @db.Uuid
  ownerScopeToken         Bytes          @unique
  stableSubjectCiphertext Bytes
  stableSubjectKeyVersion String         @db.VarChar(64)
  state                   AccountState   @default(ACTIVE)
  revision                Int            @default(1)
  restrictionCode         String?        @db.VarChar(64)
  lastActiveUseAt         DateTime       @db.Timestamptz(3)
  inactivityDeletionDueAt DateTime       @db.Timestamptz(3)
  activeDeletionTaskRef   String?        @db.Uuid
  createdAt               DateTime       @default(now()) @db.Timestamptz(3)
  updatedAt               DateTime       @updatedAt @db.Timestamptz(3)
  retentionPolicyVersion  String         @db.VarChar(64)
  retentionScope          RetentionScope @default(ACCOUNT)
  retentionAnchorAt       DateTime       @db.Timestamptz(3)
  expiresAt               DateTime?      @db.Timestamptz(3)

  externalIdentities      ExternalIdentity[]
  sessions                SessionCredential[]
  consents                NecessaryConsentRecord[]
  profile                 UserProfile?
  onboarding              OnboardingCompletion?
  continuationGrants      ViewContinuationGrant[]
  commandReceipts         CommandReceipt[]
  checkins                MorningCheckin[]
  generationIntents       GenerationIntent[]
  dailyResults            PublishedDailyResult[]
  dailyInteractions       DailyInteraction[]
  relationshipCycles      RelationshipCycle[]
  matters                 ImportantMatter[]
  memoryPurposeGrants     MemoryPurposeGrant[]
  memoryMasterPreference  MemoryMasterPreference?
  memoryMentionReceipts   MemoryMentionReceipt[]
  memorySnapshots         MemoryContextSnapshot[]
  weeklyWindows           WeeklyWindow[]
  safetyState             SafetyState?
  safetyDecisions         SafetyDecision[]
  safetyEvents            SafetyEvent[]
  safetyResponsePlans     SafetyResponsePlan[]
  recoveryReceipts        RecoveryCommandReceipt[]
  notificationPreferences NotificationPreference[]
  platformPermissions     PlatformPermissionSnapshot[]
  notificationIntents     NotificationIntent[]
  dataTasks               DataTask[]
  deletionGuards          DeletionGuard[]
  deletionChallenges      DeletionConfirmationChallenge[]
  identityVerifications   IdentityVerification[]

  @@index([state, inactivityDeletionDueAt])
  @@index([expiresAt])
  @@map("app_user_account")
}

model ExternalIdentity {
  id                     String         @id @default(uuid()) @db.Uuid
  accountId              String         @db.Uuid
  providerCode           String         @db.VarChar(32)
  subjectLookupToken     Bytes
  subjectCiphertext      Bytes
  keyVersion             String         @db.VarChar(64)
  createdAt              DateTime       @default(now()) @db.Timestamptz(3)
  lastSeenAt             DateTime       @db.Timestamptz(3)
  retentionPolicyVersion String         @db.VarChar(64)
  retentionScope         RetentionScope @default(ACCOUNT)
  retentionAnchorAt      DateTime       @db.Timestamptz(3)
  expiresAt              DateTime?      @db.Timestamptz(3)

  account UserAccount @relation(fields: [accountId], references: [id], onDelete: Restrict)

  @@unique([providerCode, subjectLookupToken])
  @@index([accountId])
  @@index([expiresAt])
  @@map("app_external_identity")
}

model SessionCredential {
  id                     String         @id @default(uuid()) @db.Uuid
  accountId              String         @db.Uuid
  tokenHash              Bytes          @unique
  deviceRef              String?        @db.VarChar(128)
  issuedAt               DateTime       @db.Timestamptz(3)
  expiresAt              DateTime       @db.Timestamptz(3)
  revokedAt              DateTime?      @db.Timestamptz(3)
  retentionPolicyVersion String         @db.VarChar(64)
  retentionScope         RetentionScope @default(ACCOUNT)
  retentionAnchorAt      DateTime       @db.Timestamptz(3)

  account            UserAccount             @relation(fields: [accountId], references: [id], onDelete: Restrict)
  continuationGrants ViewContinuationGrant[]

  @@index([accountId, expiresAt])
  @@map("app_session_credential")
}

model NecessaryConsentRecord {
  id                     String         @id @default(uuid()) @db.Uuid
  accountId              String         @db.Uuid
  noticeVersion          String         @db.VarChar(64)
  logicalIntent          String         @db.VarChar(64)
  status                 ConsentStatus
  commandRef             String         @db.Uuid
  acceptedAt             DateTime?      @db.Timestamptz(3)
  withdrawnAt            DateTime?      @db.Timestamptz(3)
  createdAt              DateTime       @default(now()) @db.Timestamptz(3)
  retentionPolicyVersion String         @db.VarChar(64)
  retentionScope         RetentionScope @default(ACCOUNT)
  retentionAnchorAt      DateTime       @db.Timestamptz(3)
  expiresAt              DateTime?      @db.Timestamptz(3)

  account               UserAccount            @relation(fields: [accountId], references: [id], onDelete: Restrict)
  onboardingCompletions OnboardingCompletion[]

  @@unique([accountId, commandRef])
  @@index([accountId, logicalIntent, createdAt(sort: Desc)])
  @@index([expiresAt])
  @@map("app_necessary_consent_record")
}

model UserProfile {
  id                      String          @id @default(uuid()) @db.Uuid
  accountId               String          @unique @db.Uuid
  revision                Int             @default(1)
  preferredNameCiphertext Bytes?
  preferredNameKeyVersion String?         @db.VarChar(64)
  expressionStyle         ExpressionStyle @default(BALANCED)
  profileSchemaVersion    String          @db.VarChar(64)
  createdAt               DateTime        @default(now()) @db.Timestamptz(3)
  updatedAt               DateTime        @updatedAt @db.Timestamptz(3)
  retentionPolicyVersion  String          @db.VarChar(64)
  retentionScope          RetentionScope  @default(ACCOUNT)
  retentionAnchorAt       DateTime        @db.Timestamptz(3)
  expiresAt               DateTime?       @db.Timestamptz(3)

  account   UserAccount           @relation(fields: [accountId], references: [id], onDelete: Restrict)
  revisions UserProfileRevision[]

  @@index([expiresAt])
  @@map("app_user_profile")
}

model UserProfileRevision {
  id                      String          @id @default(uuid()) @db.Uuid
  profileId               String          @db.Uuid
  revision                Int
  preferredNameCiphertext Bytes?
  preferredNameKeyVersion String?         @db.VarChar(64)
  expressionStyle         ExpressionStyle
  changedFieldNames       String[]
  commandRef              String          @db.Uuid
  createdAt               DateTime        @default(now()) @db.Timestamptz(3)
  retentionPolicyVersion  String          @db.VarChar(64)
  retentionScope          RetentionScope  @default(ACCOUNT)
  retentionAnchorAt       DateTime        @db.Timestamptz(3)
  expiresAt               DateTime        @db.Timestamptz(3)

  profile UserProfile @relation(fields: [profileId], references: [id], onDelete: Restrict)

  @@unique([profileId, revision])
  @@index([expiresAt])
  @@map("app_user_profile_revision")
}

model OnboardingCompletion {
  id                     String         @id @default(uuid()) @db.Uuid
  accountId              String         @unique @db.Uuid
  profileRevision        Int
  consentRecordId        String         @db.Uuid
  completionCommandRef   String         @db.Uuid
  completedAt            DateTime       @db.Timestamptz(3)
  retentionPolicyVersion String         @db.VarChar(64)
  retentionScope         RetentionScope @default(ACCOUNT)
  retentionAnchorAt      DateTime       @db.Timestamptz(3)
  expiresAt              DateTime?      @db.Timestamptz(3)

  account       UserAccount            @relation(fields: [accountId], references: [id], onDelete: Restrict)
  consentRecord NecessaryConsentRecord @relation(fields: [consentRecordId], references: [id], onDelete: Restrict)

  @@unique([accountId, completionCommandRef])
  @@index([expiresAt])
  @@map("app_onboarding_completion")
}

model ViewContinuationGrant {
  id                       String         @id @default(uuid()) @db.Uuid
  accountId                String         @db.Uuid
  sessionId                String         @db.Uuid
  surfaceCode              String         @db.VarChar(32)
  productDate              DateTime       @db.Date
  productDatePolicyVersion String         @db.VarChar(64)
  resultRef                String?        @db.Uuid
  feedbackRevision         Int?
  boundaryAt               DateTime       @db.Timestamptz(3)
  allowedOperations        String[]
  revision                 Int            @default(1)
  expiresAt                DateTime       @db.Timestamptz(3)
  invalidatedAt            DateTime?      @db.Timestamptz(3)
  createdAt                DateTime       @default(now()) @db.Timestamptz(3)
  retentionPolicyVersion   String         @db.VarChar(64)
  retentionScope           RetentionScope @default(DAY)
  retentionAnchorAt        DateTime       @db.Timestamptz(3)

  account UserAccount       @relation(fields: [accountId], references: [id], onDelete: Restrict)
  session SessionCredential @relation(fields: [sessionId], references: [id], onDelete: Restrict)

  @@index([accountId, productDate, expiresAt])
  @@index([sessionId, expiresAt])
  @@map("app_view_continuation_grant")
}

model CommandReceipt {
  id                           String         @id @default(uuid()) @db.Uuid
  accountId                    String         @db.Uuid
  commandRef                   String         @db.Uuid
  operationCode                String         @db.VarChar(64)
  targetScope                  String         @db.VarChar(32)
  targetKey                    String         @db.VarChar(160)
  productDatePolicyVersion     String?        @db.VarChar(64)
  normalizedPayloadFingerprint Bytes
  acceptedAt                   DateTime       @db.Timestamptz(3)
  terminalAt                   DateTime?      @db.Timestamptz(3)
  responseRef                  String?        @db.Uuid
  retentionPolicyVersion       String         @db.VarChar(64)
  retentionScope               RetentionScope @default(RUNTIME)
  retentionAnchorAt            DateTime       @db.Timestamptz(3)
  expiresAt                    DateTime       @db.Timestamptz(3)

  account UserAccount @relation(fields: [accountId], references: [id], onDelete: Restrict)

  @@unique([accountId, commandRef])
  @@index([accountId, operationCode, targetKey])
  @@index([expiresAt])
  @@map("runtime_command_receipt")
}

model MorningCheckin {
  id                       String         @id @default(uuid()) @db.Uuid
  accountId                String         @db.Uuid
  productDate              DateTime       @db.Date
  productDatePolicyVersion String         @db.VarChar(64)
  revision                 Int            @default(1)
  mood                     CheckinMood
  energy                   CheckinEnergy
  sleep                    CheckinSleep
  firstSubmittedAt         DateTime       @db.Timestamptz(3)
  updatedAt                DateTime       @updatedAt @db.Timestamptz(3)
  sourceCommandRef         String         @db.Uuid
  retentionPolicyVersion   String         @db.VarChar(64)
  retentionScope           RetentionScope @default(DAY)
  retentionAnchorAt        DateTime       @db.Timestamptz(3)
  expiresAt                DateTime?      @db.Timestamptz(3)

  account   UserAccount               @relation(fields: [accountId], references: [id], onDelete: Restrict)
  revisions MorningCheckinRevision[]
  snapshots GenerationInputSnapshot[]

  @@unique([accountId, productDate])
  @@index([accountId, productDate(sort: Desc)])
  @@index([expiresAt])
  @@map("app_morning_checkin")
}

model MorningCheckinRevision {
  id                     String         @id @default(uuid()) @db.Uuid
  checkinId              String         @db.Uuid
  revision               Int
  mood                   CheckinMood
  energy                 CheckinEnergy
  sleep                  CheckinSleep
  commandRef             String         @db.Uuid
  createdAt              DateTime       @default(now()) @db.Timestamptz(3)
  retentionPolicyVersion String         @db.VarChar(64)
  retentionScope         RetentionScope @default(DAY)
  retentionAnchorAt      DateTime       @db.Timestamptz(3)
  expiresAt              DateTime?      @db.Timestamptz(3)

  checkin MorningCheckin @relation(fields: [checkinId], references: [id], onDelete: Restrict)

  @@unique([checkinId, revision])
  @@index([expiresAt])
  @@map("app_morning_checkin_revision")
}

model GenerationIntent {
  id                       String          @id @default(uuid()) @db.Uuid
  accountId                String          @db.Uuid
  targetProductDate        DateTime        @db.Date
  productDatePolicyVersion String          @db.VarChar(64)
  acceptedAt               DateTime        @db.Timestamptz(3)
  revision                 Int             @default(1)
  state                    GenerationState
  resultVersion            String          @db.VarChar(64)
  manifestRef              String          @db.VarChar(128)
  manifestFingerprint      Bytes
  inputSnapshotFingerprint Bytes
  rootSeedMaterialRef      String          @db.VarChar(128)
  completionGrantVersion   String          @db.VarChar(64)
  publishedResultRef       String?         @db.Uuid
  terminalReasonCode       String?         @db.VarChar(64)
  createdAt                DateTime        @default(now()) @db.Timestamptz(3)
  updatedAt                DateTime        @updatedAt @db.Timestamptz(3)
  retentionPolicyVersion   String          @db.VarChar(64)
  retentionScope           RetentionScope  @default(DAY)
  retentionAnchorAt        DateTime        @db.Timestamptz(3)
  expiresAt                DateTime?       @db.Timestamptz(3)

  account         UserAccount              @relation(fields: [accountId], references: [id], onDelete: Restrict)
  inputSnapshot   GenerationInputSnapshot?
  invocations     GatewayInvocation[]
  publishedResult PublishedDailyResult?

  @@unique([accountId, targetProductDate])
  @@index([state, updatedAt])
  @@index([expiresAt])
  @@map("app_generation_intent")
}

model GenerationInputSnapshot {
  id                     String         @id @default(uuid()) @db.Uuid
  generationIntentId     String         @unique @db.Uuid
  checkinId              String         @db.Uuid
  checkinRevision        Int
  schemaVersion          String         @db.VarChar(64)
  snapshotPayload        Json           @db.JsonB
  snapshotFingerprint    Bytes
  createdAt              DateTime       @default(now()) @db.Timestamptz(3)
  retentionPolicyVersion String         @db.VarChar(64)
  retentionScope         RetentionScope @default(DAY)
  retentionAnchorAt      DateTime       @db.Timestamptz(3)
  expiresAt              DateTime?      @db.Timestamptz(3)

  generationIntent GenerationIntent      @relation(fields: [generationIntentId], references: [id], onDelete: Restrict)
  checkin          MorningCheckin        @relation(fields: [checkinId], references: [id], onDelete: Restrict)
  publishedResult  PublishedDailyResult?

  @@index([checkinId, checkinRevision])
  @@index([expiresAt])
  @@map("app_generation_input_snapshot")
}

model GatewayInvocation {
  id                     String             @id @default(uuid()) @db.Uuid
  workload               InvocationWorkload
  generationIntentId     String?            @db.Uuid
  weeklySummaryIntentId  String?            @db.Uuid
  planFingerprint        Bytes
  promptPackageVersion   String             @db.VarChar(64)
  schemaVersion          String             @db.VarChar(64)
  templateVersion        String             @db.VarChar(64)
  safetyBundleVersion    String             @db.VarChar(64)
  routeManifestVersion   String             @db.VarChar(64)
  routeFingerprint       Bytes
  publishGuardSnapshot   Json               @db.JsonB
  deadlineAt             DateTime           @db.Timestamptz(3)
  createdAt              DateTime           @default(now()) @db.Timestamptz(3)
  retentionPolicyVersion String             @db.VarChar(64)
  retentionScope         RetentionScope     @default(RUNTIME)
  retentionAnchorAt      DateTime           @db.Timestamptz(3)
  expiresAt              DateTime?          @db.Timestamptz(3)

  generationIntent    GenerationIntent?      @relation(fields: [generationIntentId], references: [id], onDelete: Restrict)
  weeklySummaryIntent WeeklySummaryIntent?   @relation(fields: [weeklySummaryIntentId], references: [id], onDelete: Restrict)
  attempts            GatewayAttempt[]
  memorySnapshot      MemoryContextSnapshot?

  @@index([generationIntentId])
  @@index([weeklySummaryIntentId])
  @@index([expiresAt])
  @@map("runtime_gateway_invocation")
}

model GatewayAttempt {
  id                     String                 @id @default(uuid()) @db.Uuid
  invocationId           String                 @db.Uuid
  routeRole              GatewayRouteRole
  ordinal                Int
  requestFingerprint     Bytes
  adapterVersion         String                 @db.VarChar(64)
  providerProfileVersion String                 @db.VarChar(64)
  endpointCode           String                 @db.VarChar(64)
  modelVersion           String                 @db.VarChar(128)
  startedAt              DateTime               @db.Timestamptz(3)
  finishedAt             DateTime?              @db.Timestamptz(3)
  outcome                GatewayAttemptOutcome?
  inputTokens            Int?
  outputTokens           Int?
  costMicros             BigInt?
  providerRequestRef     String?                @db.VarChar(160)
  candidateFingerprint   Bytes?
  failureCode            String?                @db.VarChar(64)
  retentionPolicyVersion String                 @db.VarChar(64)
  retentionScope         RetentionScope         @default(RUNTIME)
  retentionAnchorAt      DateTime               @db.Timestamptz(3)
  expiresAt              DateTime               @db.Timestamptz(3)

  invocation GatewayInvocation @relation(fields: [invocationId], references: [id], onDelete: Restrict)
  candidate  GatewayCandidate?

  @@unique([invocationId, routeRole, ordinal])
  @@index([providerProfileVersion, startedAt])
  @@index([expiresAt])
  @@map("runtime_gateway_attempt")
}

model GatewayCandidate {
  id                        String         @id @default(uuid()) @db.Uuid
  attemptId                 String         @unique @db.Uuid
  schemaVersion             String         @db.VarChar(64)
  completePayloadCiphertext Bytes
  payloadKeyVersion         String         @db.VarChar(64)
  candidateFingerprint      Bytes
  validationReceipt         Json           @db.JsonB
  validatedAt               DateTime       @db.Timestamptz(3)
  expiresAt                 DateTime       @db.Timestamptz(3)
  retentionPolicyVersion    String         @db.VarChar(64)
  retentionScope            RetentionScope @default(RUNTIME)
  retentionAnchorAt         DateTime       @db.Timestamptz(3)

  attempt GatewayAttempt @relation(fields: [attemptId], references: [id], onDelete: Restrict)

  @@index([expiresAt])
  @@map("runtime_gateway_candidate")
}

model PublishedDailyResult {
  id                     String         @id @default(uuid()) @db.Uuid
  accountId              String         @db.Uuid
  generationIntentId     String         @unique @db.Uuid
  inputSnapshotId        String         @unique @db.Uuid
  productDate            DateTime       @db.Date
  resultVersion          String         @db.VarChar(64)
  schemaVersion          String         @db.VarChar(64)
  generatedAt            DateTime       @db.Timestamptz(3)
  ruleFactsPayload       Json           @db.JsonB
  expressionCorePayload  Json           @db.JsonB
  provenancePayload      Json           @db.JsonB
  validationReceipt      Json           @db.JsonB
  resultFingerprint      Bytes
  retentionPolicyVersion String         @db.VarChar(64)
  retentionScope         RetentionScope @default(DAY)
  retentionAnchorAt      DateTime       @db.Timestamptz(3)
  expiresAt              DateTime?      @db.Timestamptz(3)

  account          UserAccount                @relation(fields: [accountId], references: [id], onDelete: Restrict)
  generationIntent GenerationIntent           @relation(fields: [generationIntentId], references: [id], onDelete: Restrict)
  inputSnapshot    GenerationInputSnapshot    @relation(fields: [inputSnapshotId], references: [id], onDelete: Restrict)
  visibility       PublishedResultVisibility?
  contentSlots     ResultContentSlot[]
  dailyInteraction DailyInteraction?
  mentionReceipts  MemoryMentionReceipt[]

  @@unique([accountId, productDate])
  @@index([accountId, productDate(sort: Desc)])
  @@index([expiresAt])
  @@map("app_published_daily_result")
}

model PublishedResultVisibility {
  id                     String              @id @default(uuid()) @db.Uuid
  resultId               String              @unique @db.Uuid
  state                  ContentDisplayState @default(AVAILABLE)
  revision               Int                 @default(1)
  sourceFingerprint      Bytes
  blockedReasonCode      String?             @db.VarChar(64)
  updatedAt              DateTime            @updatedAt @db.Timestamptz(3)
  retentionPolicyVersion String              @db.VarChar(64)
  retentionScope         RetentionScope      @default(DAY)
  retentionAnchorAt      DateTime            @db.Timestamptz(3)
  expiresAt              DateTime?           @db.Timestamptz(3)

  result PublishedDailyResult @relation(fields: [resultId], references: [id], onDelete: Restrict)

  @@index([expiresAt])
  @@map("app_published_result_visibility")
}

model ResultContentSlot {
  id                     String         @id @default(uuid()) @db.Uuid
  resultId               String         @db.Uuid
  segmentPath            String         @db.VarChar(160)
  fallbackPayload        Json?          @db.JsonB
  fallbackFingerprint    Bytes?
  fallbackSchemaVersion  String?        @db.VarChar(64)
  createdAt              DateTime       @default(now()) @db.Timestamptz(3)
  retentionPolicyVersion String         @db.VarChar(64)
  retentionScope         RetentionScope @default(DAY)
  retentionAnchorAt      DateTime       @db.Timestamptz(3)
  expiresAt              DateTime?      @db.Timestamptz(3)

  result               PublishedDailyResult         @relation(fields: [resultId], references: [id], onDelete: Restrict)
  personalizedFragment PersonalizedContentFragment?

